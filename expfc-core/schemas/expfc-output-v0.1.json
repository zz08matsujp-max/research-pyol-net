{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://research.pyol.net/schemas/expfc-output-v0.1.json",
  "title": "ExPFC Core Output v0.1",
  "description": "Output contract from ExPFC Core to app layer. Note: NO explanatory text is included. Multi-language UI is the app's responsibility.",
  "type": "object",
  "required": [
    "bonno_vector",
    "scam_probability",
    "confidence",
    "alert_level",
    "fired_signatures",
    "source_attribution"
  ],
  "properties": {
    "bonno_vector": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["dimension_id", "intensity"],
        "properties": {
          "dimension_id": {
            "type": "string",
            "description": "Identifier from bonno_ontology.yaml (e.g. 'greed_desire')."
          },
          "intensity": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      },
      "description": "V: affliction-stimulation vector. Length depends on requested level (3 / 9 / 108)."
    },
    "scam_probability": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Final scam probability."
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Confidence in the scam_probability estimate."
    },
    "alert_level": {
      "type": "string",
      "enum": ["none", "info", "caution", "warning", "danger"],
      "description": "Discrete alert level. The app maps this to its UI (mode A/B/C/D)."
    },
    "fired_signatures": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["signature_type", "score", "fired"],
        "properties": {
          "signature_type": {
            "type": "string",
            "enum": ["concentration", "suppression", "incompatibility"],
            "description": "Which of the three scam fingerprints. See §14.3."
          },
          "score": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "fired": {
            "type": "boolean",
            "description": "Whether the score exceeded the threshold."
          }
        }
      },
      "description": "Per-signature firing report."
    },
    "source_attribution": {
      "type": "object",
      "required": ["score", "missing_items"],
      "properties": {
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "1.0 means all required source attributions are present; 0.0 means none."
        },
        "missing_items": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "company_name",
              "registration_number",
              "address",
              "phone_number",
              "fsa_registration",
              "tokushoho_disclosure",
              "privacy_policy"
            ]
          },
          "description": "Items legally required but absent from the text."
        }
      }
    },
    "meta": {
      "type": "object",
      "description": "Optional metadata about the judgment process.",
      "properties": {
        "core_version": { "type": "string" },
        "level_used": { "type": "integer", "enum": [1, 2, 3] },
        "anonymous_baseline_used": {
          "type": "boolean",
          "description": "True if Anonymous Baseline U was used instead of a real user profile."
        }
      }
    }
  }
}
