---
// src/pages/en/index.astro - English top page
// Schema.org JSON-LD with Organization + Person (for Knowledge Graph)
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE, AUTHOR } from '../../config';

const organizationJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  'name': 'Mindseed Research',
  'alternateName': 'マインドシード研究所',
  'url': SITE.url,
  'logo': `${SITE.url}/favicon.svg`,
  'description': 'Bonnō × AI — a 20-year research program adopting 2,500 years of internal Buddhist observation as a coordinate system for AI\'s understanding of the human.',
  'founder': {
    '@type': 'Person',
    'name': AUTHOR.nameRomaji,
    'alternateName': AUTHOR.shortName,
    'url': `${SITE.url}/en/about/`
  },
  'sameAs': [
    SITE.githubRepo
  ]
};
---

<BaseLayout title="Home" lang="en" jsonLd={organizationJsonLd}>
  <section class="hero">
    <h1>Mindseed Research</h1>
    <p class="lead">Bonnō × AI — A research program in human understanding, beginning with anti-scam.</p>
    <p class="sub">A 20-year program / Sole-proprietorship research / Toshinobu Matsuura (Toshi)</p>
  </section>

  <section>
    <h2>The researcher</h2>
    <p>
      <strong>Toshinobu Matsuura (Toshi)</strong> — age 68, former infrastructure engineer, principal of Mindseed Research (sole proprietorship).
      Career through Kansai Electric Power Company (KEPCO), independent business, and Samsung SDS, then retirement and independent research.
      Over 40 years of infrastructure engineering centered on C/C++ and assembly. Based in Wakayama, Japan.
      <a href="/en/about/">Full profile →</a>
    </p>
  </section>

  <section>
    <h2>Three layers of the program</h2>
    <ul class="layered-list">
      <li><strong>Short term</strong>: PYOL Mind Mirror (<a href="https://ai.pyol.net">ai.pyol.net</a>) — a fraud-awareness tool already in production. The starting point of this research program</li>
      <li><strong>Mid term</strong>: Buddhism × AI — an integrated database of mental-affliction taxonomy and scam-virus signatures (under design)</li>
      <li><strong>Long term</strong>: Contribution to AI's capacity for human understanding in the ASI era</li>
    </ul>
  </section>

  <section>
    <h2>Core essays</h2>
    <div class="callout">
      <span class="callout-label">Essay §0 — Level 1 (methodological)</span>
      <h3><a href="/en/essays/buddhism-as-coordinate-system/">Buddhism as a Coordinate System — A New Computational Foundation for Understanding the Human</a></h3>
      <p>Neuroscience cannot capture the semantic resolution of human emotion. The fundamental purpose of this program: to adopt the 2,500 years of internal Buddhist observation as the coordinate system for modern neural-network engineering.</p>
    </div>
    <div class="callout">
      <span class="callout-label">Essay §15 — Level 2 (strategic)</span>
      <h3><a href="/en/essays/precision-economics/">Economies of Precision vs Economies of Scale — The Domain Big AI Cannot Enter</a></h3>
      <p>Big AI is structurally optimized for economies of scale, and there are domains it cannot enter as a result. This program deliberately occupies that domain — going narrow and deep where the giants go wide and shallow.</p>
    </div>
  </section>

  <section>
    <h2>Starting point of implementation</h2>
    <p>This research program begins from an already-running tool. The full mental-affliction mapping is still in design; what runs today is a general fraud-awareness tool for the public.</p>
    <p>
      <a href="https://ai.pyol.net">ai.pyol.net</a> — PYOL Mind Mirror (free, in production)
    </p>
  </section>

  <hr class="divider" />

  <nav class="page-nav" aria-label="Main pages">
    <a href="/en/about/">About →</a>
    <a href="/en/concept/">Research Program →</a>
    <a href="/en/essays/">Essays →</a>
    <a href="/en/contact/">Contact →</a>
  </nav>
</BaseLayout>
